# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.idea/
*.swp
*.swo
# keep the shared VS Code settings, ignore personal ones
.vscode/*
!.vscode/settings.json

# --- Office temp / lock files (e.g. while the .docx is open) ---
~$*

# --- Logs ---
*.log
php_errors.log

# --- Database dumps / backups (schema.sql is kept) ---
database/*.sql
!database/schema.sql
*.sql.gz
*.bak

# --- Environment / secrets ---
.env
.env.*

# --- Dependencies (if Node/Composer tools are added later) ---
node_modules/
vendor/

# --- Temp files ---
tmp/
*.tmp
